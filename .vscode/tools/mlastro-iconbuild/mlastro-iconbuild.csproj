<Project Sdk="Microsoft.NET.Sdk">

  <!--
    mlastro-iconbuild
    Converts a monochrome SVG (paths + text) into the single-colour GeometryGroup
    XAML used for the NINA dockable icon (Resources\MLAstroTPPAIcon.xaml).
    Text ("RPA") is vectorised to glyph outline paths via WPF FormattedText.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>mlastro-iconbuild</AssemblyName>
    <RootNamespace>mlastro_iconbuild</RootNamespace>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

</Project>
