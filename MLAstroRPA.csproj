<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MLAstroRPA NINA plugin (MLAstro Robotic Polar Alignment hardware control only; TPPA is a
    SEPARATE plugin that talks to this one through the NINA message broker).
    Single plugin assembly "NINA.Plugins.MLAstroRPA" (code namespaces + RootNamespace stay
    "NINA.Plugins.PolarAlignment"; generated Settings/Locale names depend on RootNamespace,
    not on AssemblyName).
    Display name comes from AssemblyTitle = "MLAstroRPA".
    PluginId (GUID) = af3ab7b3-f11a-4671-a87f-e7c3985fb509 (UNIQUE, distinct from the standalone
    TPPA plugin 1de8d7d3-f11e-494c-a371-95cb48dffa18 and from the merged MLAstroRPA+TPPA plugin
    1352D162-2E66-4F80-A05B-854F021DB913 so NINA treats them as separate plugins).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Project file is MLAstroRPA.csproj; AssemblyName = NINA.Plugins.MLAstroRPA so the plugin DLL
         is NINA.Plugins.MLAstroRPA.dll. RootNamespace stays NINA.Plugins.PolarAlignment because the
         code keeps the TPPA namespaces and generated names must stay valid (e.g.
         NINA.Plugins.PolarAlignment.Properties and the embedded Locale resource
         NINA.Plugins.PolarAlignment.Locale.Locale). -->
    <AssemblyName>NINA.Plugins.MLAstroRPA</AssemblyName>
    <RootNamespace>NINA.Plugins.PolarAlignment</RootNamespace>

    <AssemblyTitle>MLAstroRPA</AssemblyTitle>
    <Title>MLAstroRPA</Title>
    <Product>MLAstroRPA</Product>
    <Company>MLAstro</Company>
    <Authors>MLAstro</Authors>
    <Description>MLAstroRPA - NINA plugin for the MLAstro Robotic Polar Alignment hardware:
CONTROL / CONNECTION / CONFIGURATION options tabs, header bar and the MLAstro docking panel.</Description>
    <Copyright>Copyright © 2021-2026</Copyright>
    <Version>2.2.1.0</Version>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <FileVersion>2.2.1.0</FileVersion>
    <InformationalVersion>2.2.1.0</InformationalVersion>

    <!-- CS0618: NINA exposes obsolete RelayCommand/AsyncCommand contracts that the plugin uses
         deliberately. NU1701: older packages (ToastNotifications/FreeImage) restored for net8.0.
         MSB3277: System.Text.Json 8.0 vs 9.0 conflict from third-party NINA.PlateSolving.dll.
         CS8632: MLAstro-origin code uses nullable annotations ('?') while the merged project keeps
         Nullable disabled (TPPA base) - annotations are harmless, suppress the warning. -->
    <NoWarn>$(NoWarn);CS0618;NU1701;MSB3277;CS8632</NoWarn>

    <!-- Keep the standalone tools\mlastro-iconbuild project (its own obj/bin + generated
         AssemblyInfo.cs) out of THIS plugin's default item globs. Otherwise building the plugin
         would compile tools\**\*.cs into the plugin (and its WPF _wpftmp project), producing
         CS0579 duplicate attribute errors. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>

    <!-- Single-DLL plugin output -->
    <RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.1.2.9001" />
    <!-- Compile-time only; NINA supplies the runtime copies (single-DLL plugin). -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Management" Version="8.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded MLAstro brand logo images (pack URIs in HeaderBar.xaml) -->
    <Resource Include="MLAstroRPA-navigation\Resources\MLAstro_logo.png" />
    <Resource Include="MLAstroRPA-navigation\Resources\MRPA-on.png" />
    <Resource Include="MLAstroRPA-navigation\Resources\MRPA-off.png" />
    <Resource Include="MLAstroRPA-navigation\Resources\MRPA-on.svg" />
    <Resource Include="MLAstroRPA-navigation\Resources\MRPA-off.svg" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- Stop NINA (all configurations) so the plugin DLL file handle is released before it is
         copied over. 2>nul suppresses the benign "process not found" warning. -->
    <Exec IgnoreExitCode="true" Command="taskkill /f /im NINA.exe 2>nul" />
    <Exec IgnoreExitCode="true" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;for ($i=0; $i -lt 50; $i++) { if (-not (Get-Process -Name NINA -ErrorAction SilentlyContinue)) { break }; Start-Sleep -Milliseconds 200 }&quot;" />
    <Exec IgnoreExitCode="true" Command="&#xD;&#xA;if not exist &quot;%25localappdata%25\NINA\Plugins&quot; (&#xD;&#xA;    echo &quot;Creating Plugins %25localappdata%25\NINA\Plugins folder&quot;&#xD;&#xA;    mkdir  &quot;%25localappdata%25\NINA\Plugins&quot;&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;if exist &quot;%25localappdata%25\NINA\Plugins\3.0.0\MLAstroRPA&quot; (&#xD;&#xA;    echo &quot; folder cleanup&quot;&#xD;&#xA;    rmdir &quot;%25localappdata%25\NINA\Plugins\3.0.0\MLAstroRPA&quot; /S /Q&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;if not exist &quot;%25localappdata%25\NINA\Plugins\3.0.0\MLAstroRPA&quot; (&#xD;&#xA;    echo &quot;Creating %25localappdata%25\NINA\Plugins\3.0.0\MLAstroRPA folder&quot;&#xD;&#xA;    mkdir  &quot;%25localappdata%25\NINA\Plugins\3.0.0\MLAstroRPA&quot;&#xD;&#xA;)&#xD;&#xA;echo &quot;Copying $(TargetFileName)&quot;&#xD;&#xA;copy &quot;$(TargetDir)$(TargetFileName)&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\MLAstroRPA\$(TargetName)$(TargetExt)&quot; /Y&#xD;&#xA;" />
    <!-- Only the plugin DLL is deployed. NINA shows the logo via
         AssemblyMetadata("FeaturedImageURL") and the in-UI logos are embedded resources. -->
  </Target>

  <!-- Keep the MSI/GitHub-release staging copy of the plugin DLL fresh on EVERY build
       (Debug included - user request 2026-09-20: build Debug cũng copy DLL tới các thư mục đích
       giống build Release). Building the installer (MLAstroRPA_TPPA.Installer.wixproj) triggers
       this via the ProjectReference, and Package.wxs harvests the DLL from
       Installer\MSI\Plugin\MLAstroRPA_TPPA. Lưu ý: sau khi build Debug, phải build lại Release
       trước khi đóng MSI/release nếu không muốn gói nhầm DLL Debug. -->
  <Target Name="RefreshInstallerPluginDll" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <StagedPluginDir>$(ProjectDir)Installer\MSI\Plugin\MLAstroRPA</StagedPluginDir>
    </PropertyGroup>
    <MakeDir Directories="$(StagedPluginDir)" Condition="!Exists('$(StagedPluginDir)')" />
    <Copy SourceFiles="$(TargetDir)NINA.Plugins.MLAstroRPA.dll" DestinationFolder="$(StagedPluginDir)" />
    <Message Importance="High" Text="[MLAstroRPA] Plugin DLL copied to MSI staging: $(StagedPluginDir)" />
  </Target>

</Project>
