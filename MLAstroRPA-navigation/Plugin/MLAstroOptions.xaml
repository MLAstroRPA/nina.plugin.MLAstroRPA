<ResourceDictionary x:Class="MLAstroRPA.Plugin.MLAstroOptions"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="clr-namespace:MLAstroRPA.Dockables">
    <BooleanToVisibilityConverter x:Key="MlaRpaBoolToVis" />

        <!-- CONTROL tab body (hosted with DataContext = MLAstroController) -->
    <DataTemplate x:Key="MlaRpaControlBody">
        <view:PolarAlignmentDockable DataContext="{Binding PolarAlignmentVM}" />
    </DataTemplate>

    <!-- CONNECTION tab body (hosted with DataContext = MLAstroController) -->
    <DataTemplate x:Key="MlaRpaConnectionBody">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Loaded="OnOptionsScrollViewerLoaded"
                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <StackPanel Margin="10">
                    <Grid>
                    <StackPanel Margin="10">                        <!-- Connection type: pick EXACTLY one (Serial or Wireless). -->
                        <StackPanel Margin="0,0,0,10" HorizontalAlignment="Left">
                            <TextBlock Text="Connection type" Margin="0,0,0,5" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="220" SelectedIndex="{Binding TransportModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Serial connection" />
                                    <ComboBoxItem Content="Wireless connection" />
                                </ComboBox>
                                <!-- Warning: switching the connection type drops the open session (a single transport holds control). -->
                                <TextBlock
                                    Margin="10,0,0,0"
                                    MaxWidth="430"
                                    VerticalAlignment="Center"
                                    Foreground="Orange"
                                    TextWrapping="Wrap"
                                    Text="⚠️ Switch connection will disconnect the current session."
                                    ToolTip="Switching Serial ↔ Wireless always disconnects the transport in use, then connects the newly selected one." />
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== SERIAL SETTINGS (hidden completely when the Wireless connection is selected) ===== -->
                        <StackPanel Visibility="{Binding IsSerialSettingsVisible, Converter={StaticResource MlaRpaBoolToVis}}">
                        <!-- Auto scan COM port: ON -> probe every COM port for the controller and connect (Start button),
                             OFF -> pick the port manually in the COM-port list. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding IsAutoScanComPort, Mode=TwoWay}"
                                      IsEnabled="{Binding IsExternalUnlocked}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      ToolTip="Probe every COM port for the MLAstro controller and connect to the port that answers." />
                            <TextBlock Text="Auto scan COM port"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Width="220" Margin="0,0,10,10"
                                        Visibility="{Binding IsManualComPortVisible, Converter={StaticResource MlaRpaBoolToVis}}">
                                <TextBlock Text="COM Port" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding AvailableComPortItems}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="PortName"
                                          SelectedValue="{Binding Settings.ComPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="OnComPortDropDownOpened" />
                            </StackPanel>

                            <StackPanel Width="220" Margin="0,0,10,10"
                                        Visibility="{Binding IsAutoScanComPort, Converter={StaticResource MlaRpaBoolToVis}}">
                                <TextBlock Text="Auto scan" Margin="0,0,0,5" />
                                <Button Content="{Binding AutoScanButtonText}"
                                        Width="110"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsExternalUnlocked}"
                                        Command="{Binding StartAutoScanCommand}"
                                        ToolTip="Scan every COM port for the controller and connect to the port that answers. While connected the button turns into Disconnect." />
                                <TextBlock Text="{Binding AutoScanStatus}"
                                           Foreground="Gray"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Hidden in auto-scan mode: the Start button connects and disconnects there. -->
                            <Button Content="{Binding SerialConnectButtonText}"
                                    Width="110"
                                    Margin="0,0,10,0"
                                    Command="{Binding ToggleSerialConnectionCommand}"
                                    Visibility="{Binding IsManualComPortVisible, Converter={StaticResource MlaRpaBoolToVis}}" />
                            <!-- Reset ESP32 only makes sense on a live session: shown once the connection is up. -->
                            <Button Content="Reset ESP32"
                                    Width="110"
                                    Margin="0,0,10,0"
                                    Command="{Binding ResetEsp32Command}"
                                    Visibility="{Binding IsSerialConnected, Converter={StaticResource MlaRpaBoolToVis}}" />
                            <TextBlock Text="{Binding AutoReconnectStatus}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="Blue" />
                        </StackPanel>

                        <TextBlock Text="{Binding SerialConnectionStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,0,0,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Handshake: "
                                       Foreground="Gray"
                                       FontSize="11" />
                            <TextBlock Text="{Binding SerialHandshakeStatus}"
                                       Foreground="Gray"
                                       FontSize="11" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Locks the switch while TPPA borrows the port (external control): the '?' poll auto-pauses then,
                                 so the user cannot toggle it during a TPPA session. It unlocks when TPPA hands the port back. -->
                            <CheckBox IsChecked="{Binding IsPauseQuery, Mode=TwoWay}"
                                      IsEnabled="{Binding IsExternalUnlocked}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Text="Pause polling '?'"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Handshake Timeout:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       FontSize="12" />
                            <TextBox Text="{Binding HandshakeTimeoutMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Width="70"
                                     MaxLength="4"
                                     VerticalAlignment="Center"
                                     PreviewTextInput="OnNumericOnlyPreviewTextInput"
                                     KeyDown="OnTimingTextBoxKeyDown" />
                            <TextBlock Text="ms (300 - 5000)"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Polling Period:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       FontSize="12" />
                            <TextBox Text="{Binding PollingIntervalMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Width="70"
                                     MaxLength="4"
                                     VerticalAlignment="Center"
                                     PreviewTextInput="OnNumericOnlyPreviewTextInput"
                                     KeyDown="OnTimingTextBoxKeyDown" />
                            <TextBlock Text="ms (100 - 1000)"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        </StackPanel>

                        <!-- ===== WIRELESS SETTINGS (WebSocket qua mDNS/IP) ===== -->
                        <StackPanel Visibility="{Binding IsWirelessSettingsVisible, Converter={StaticResource MlaRpaBoolToVis}}">
                            <StackPanel Width="320" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TextBlock Text="Address:" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.MlaHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="hostname (MLAstroRPA.local) or device IP"
                                           Foreground="Gray"
                                           FontSize="11"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{Binding SerialConnectButtonText}"
                                        Width="110"
                                        Margin="0,0,10,0"
                                        Command="{Binding ToggleSerialConnectionCommand}" />
                                <!-- Reset ESP32 only makes sense on a live session: shown once the connection is up. -->
                                <Button Content="Reset ESP32"
                                        Width="110"
                                        Margin="0,0,10,0"
                                        Command="{Binding ResetEsp32Command}"
                                        Visibility="{Binding IsSerialConnected, Converter={StaticResource MlaRpaBoolToVis}}" />
                                <TextBlock Text="{Binding AutoReconnectStatus}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="Blue" />
                            </StackPanel>

                            <TextBlock Text="{Binding SerialConnectionStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="0,0,0,4" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Handshake: "
                                           Foreground="Gray"
                                           FontSize="11" />
                                <TextBlock Text="{Binding SerialHandshakeStatus}"
                                           Foreground="Gray"
                                           FontSize="11" />
                            </StackPanel>

                            <TextBlock Text="System log:" Margin="0,0,0,5" />

                            <!-- Buttons matching the Web UI: RESET ERROR / Export CSV / Clear -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="⚠ RESET ERROR"
                                        Width="120"
                                        Margin="0,0,10,0"
                                        Command="{Binding ResetErrorCommand}" />
                                <Button Content="Export CSV"
                                        Width="100"
                                        Margin="0,0,10,0"
                                        Command="{Binding ExportSystemLogCommand}" />
                                <Button Content="Clear"
                                        Width="80"
                                        Command="{Binding ClearSystemLogCommand}" />
                            </StackPanel>

                            <!-- Log table like the Web UI: [time] content, coloured by level,
                                 newest line on top, 50 lines at most. The background follows the NINA theme
                                 (no background tint), selectable and copyable through the context menu. -->
                            <RichTextBox Height="180"
                                         MinHeight="180"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewMouseWheel="OnSerialTerminalPreviewMouseWheel"
                                         Loaded="OnSystemLogLoaded">
                                <RichTextBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 Background="White"
                                                 Foreground="White">
                                        <MenuItem Header="Copy" Click="OnSerialTerminalCopyClick" />
                                        <MenuItem Header="Clear" Command="{Binding ClearSystemLogCommand}" />
                                    </ContextMenu>
                                </RichTextBox.ContextMenu>
                            </RichTextBox>

                            <Thumb Height="8"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Stretch"
                                   Cursor="SizeNS"
                                   Background="Transparent"
                                   DragDelta="OnSerialTerminalResizeThumbDragDelta" />
                        </StackPanel>

                        <!-- ===== SERIAL TERMINAL (only shown when the Serial connection is selected) ===== -->
                        <StackPanel Visibility="{Binding IsSerialSettingsVisible, Converter={StaticResource MlaRpaBoolToVis}}">
                            <TextBlock Text="Serial Terminal" Margin="0,0,0,5" />
                        <RichTextBox Height="180"
                                     MinHeight="180"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewMouseWheel="OnSerialTerminalPreviewMouseWheel"
                                     PreviewKeyDown="OnSerialTerminalPreviewKeyDown"
                                     Loaded="OnSerialTerminalLoaded">
                            <RichTextBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Background="White"
                                             Foreground="White">
                                    <MenuItem Header="Copy" Click="OnSerialTerminalCopyClick" />
                                    <MenuItem Header="Clear" Command="{Binding ClearSerialTerminalCommand}" />
                                    <MenuItem Header="Hex display"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsHexDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>

                        <Thumb Height="8"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Stretch"
                               Cursor="SizeNS"
                               Background="Transparent"
                               DragDelta="OnSerialTerminalResizeThumbDragDelta" />
                        </StackPanel>

                        <DockPanel Visibility="{Binding IsSerialSettingsVisible, Converter={StaticResource MlaRpaBoolToVis}}">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <CheckBox IsChecked="{Binding IsHexInputEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0" />
                                <TextBlock Text="Hex"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Margin="0,0,10,0" />
                                <Button Content="Send"
                                        Width="90"
                                        Command="{Binding SendSerialCommand}" />
                            </StackPanel>
                            <TextBox Text="{Binding SerialTerminalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{Binding SerialInputMaxLength}"
                                     TextChanged="OnSerialTerminalInputTextChanged"
                                     PreviewKeyDown="OnSerialTerminalInputPreviewKeyDown" />
                        </DockPanel>
                    </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
    </DataTemplate>

    <!-- HARDWARE SETTING tab body (hosted with DataContext = MLAstroController) -->
    <DataTemplate x:Key="MlaRpaHardwareBody">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Loaded="OnOptionsScrollViewerLoaded"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <StackPanel Margin="10">
                <TextBlock Text="⚠️ Not connected&#10;&#10;Open the CONNECTION tab and connect to the MLAstro RPA hardware (Serial or Wireless) to configure device settings."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#F39C12"
                           Margin="0,20,0,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PolarAlignmentVM.ControlsVisibility}" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Expander Header="Soft Limits (Degrees)" Margin="0,0,0,15" IsExpanded="True"
                          Visibility="{Binding IsHandshakeSuccessful, Converter={StaticResource MlaRpaBoolToVis}}">
                    <StackPanel Margin="10">
                        <TextBlock Text="AZ Limits" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Width="220" Margin="0,0,10,10">
                                <TextBlock Text="AZ Min" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.LimitAzMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,10,10">
                                <TextBlock Text="AZ Max" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.LimitAzMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="ALT Limits" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,10,10">
                                <TextBlock Text="ALT Min" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.LimitAltMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,10,10">
                                <TextBlock Text="ALT Max" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.LimitAltMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="Motor Driver (TMC2209)" Margin="0,0,0,15" IsExpanded="True"
                          Visibility="{Binding IsHandshakeSuccessful, Converter={StaticResource MlaRpaBoolToVis}}">
                    <StackPanel Margin="10">
                        <GroupBox Header="AZ Motor" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox IsChecked="{Binding Settings.AzReverse, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <TextBlock Text="Reverse Direction"
                                               VerticalAlignment="Center"
                                               FontSize="14" />
                                </StackPanel>
                                <WrapPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Run Current (mA)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzCurrentRun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Hold Current (mA)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzCurrentHold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Start-up Booster (%)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzBooster, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Soft CoolStep (%)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzCoolStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Microsteps" Margin="0,0,0,5" />
                                        <ComboBox SelectedValue="{Binding Settings.AzMicrosteps, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="1" Tag="1" />
                                            <ComboBoxItem Content="2" Tag="2" />
                                            <ComboBoxItem Content="4" Tag="4" />
                                            <ComboBoxItem Content="8" Tag="8" />
                                            <ComboBoxItem Content="16" Tag="16" />
                                            <ComboBoxItem Content="32" Tag="32" />
                                            <ComboBoxItem Content="64" Tag="64" />
                                            <ComboBoxItem Content="128" Tag="128" />
                                            <ComboBoxItem Content="256" Tag="256" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Accel (steps/sÂ²)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzAccel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Decel (steps/sÂ²)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzDecel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Steps/Degree" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AzStepsPerDegree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Mode" Margin="0,0,0,5" />
                                        <ComboBox SelectedValue="{Binding Settings.AzMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="StealthChop" Tag="0" />
                                            <ComboBoxItem Content="SpreadCycle" Tag="1" />
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="ALT Motor">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox IsChecked="{Binding Settings.AltReverse, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <TextBlock Text="Reverse Direction"
                                               VerticalAlignment="Center"
                                               FontSize="14" />
                                </StackPanel>
                                <WrapPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Run Current (mA)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltCurrentRun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Hold Current (mA)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltCurrentHold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Start-up Booster (%)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltBooster, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Soft CoolStep (%)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltCoolStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Microsteps" Margin="0,0,0,5" />
                                        <ComboBox SelectedValue="{Binding Settings.AltMicrosteps, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="1" Tag="1" />
                                            <ComboBoxItem Content="2" Tag="2" />
                                            <ComboBoxItem Content="4" Tag="4" />
                                            <ComboBoxItem Content="8" Tag="8" />
                                            <ComboBoxItem Content="16" Tag="16" />
                                            <ComboBoxItem Content="32" Tag="32" />
                                            <ComboBoxItem Content="64" Tag="64" />
                                            <ComboBoxItem Content="128" Tag="128" />
                                            <ComboBoxItem Content="256" Tag="256" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Accel (steps/sÂ²)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltAccel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Decel (steps/sÂ²)" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltDecel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Steps/Degree" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Settings.AltStepsPerDegree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,10">
                                        <TextBlock Text="Mode" Margin="0,0,0,5" />
                                        <ComboBox SelectedValue="{Binding Settings.AltMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="StealthChop" Tag="0" />
                                            <ComboBoxItem Content="SpreadCycle" Tag="1" />
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>

                <Expander Header="Backlash &amp; P.A Overshoot" Margin="0,0,0,15" IsExpanded="True"
                          Visibility="{Binding IsHandshakeSuccessful, Converter={StaticResource MlaRpaBoolToVis}}">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding Settings.BacklashEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Text="Enable Anti Backlash on firmware"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </StackPanel>
                        <WrapPanel Margin="24,0,0,10">
                            <StackPanel Width="220" Margin="0,0,10,10">
                                <TextBlock Text="AZ Backlash (steps)" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.BacklashAz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,10,10">
                                <TextBlock Text="ALT Backlash (steps)" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Settings.BacklashAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <CheckBox IsChecked="{Binding Settings.OvershootEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Text="Enable Alt P.A Overshoot on firmware"
                                       VerticalAlignment="Center"
                                       FontSize="14" />
                        </StackPanel>
                        <StackPanel Margin="24,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding Settings.OvershootMoveUp, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Text="Move up overshoot"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding Settings.OvershootMoveDown, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Text="Move down overshoot"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Overshoot Amount:" Margin="0,0,0,5" />
                                <WrapPanel>
                                    <DockPanel Width="70" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Right" Text="°" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBox Text="{Binding Settings.OvershootDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Width="70" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Right" Text="'" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBox Text="{Binding Settings.OvershootMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Width="70" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Right" Text="&quot;" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBox Text="{Binding Settings.OvershootSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="WiFi Configuration" Margin="0,0,0,15" IsExpanded="True"
                          Visibility="{Binding IsHandshakeSuccessful, Converter={StaticResource MlaRpaBoolToVis}}">
                    <StackPanel Margin="10">
                        <GroupBox Header="Access Point (Hotspot)" Margin="0,0,0,10">
                            <WrapPanel Margin="10">
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="AP SSID" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Settings.ApSsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="AP Password" Margin="0,0,0,5" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Width="30"
                                                Content="👁"
                                                FontSize="14"
                                                ToolTip="Show/Hide AP password"
                                                Command="{Binding ToggleShowApPasswordCommand}" />
                                        <TextBox Text="{Binding ApPassDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="IsReadOnly" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowApPassword}" Value="True">
                                                            <Setter Property="IsReadOnly" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="AP IP Address" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Settings.ApIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="Subnet Mask" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Settings.ApSubnet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="Station Mode (Connect to Router)">
                            <WrapPanel Margin="10">
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="WiFi SSID" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Settings.WifiSsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="WiFi Password" Margin="0,0,0,5" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Width="30"
                                                Content="👁"
                                                FontSize="14"
                                                ToolTip="Show/Hide WiFi password"
                                                Command="{Binding ToggleShowStaPasswordCommand}" />
                                        <TextBox Text="{Binding WifiPassDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="IsReadOnly" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowStaPassword}" Value="True">
                                                            <Setter Property="IsReadOnly" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,10">
                                    <TextBlock Text="Current STA Mode IP" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Settings.WifiIp, Mode=TwoWay}"
                                             IsReadOnly="True"
                                             ToolTip="Read from telemetry (STAi). Empty = no IP address received from the router yet." />
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>

                <!-- Configuration Management -->
                <Border Padding="10" Margin="0,0,0,15" CornerRadius="5"
                        Visibility="{Binding IsHandshakeSuccessful, Converter={StaticResource MlaRpaBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="💾 Configuration Management"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,10" />
                        <Button Content="⚡ APPLY SETTINGS"
                                Height="36"
                                Margin="0,0,0,8"
                                Command="{Binding ApplySettingsCommand}" />
                        <Button Content="✓ SAVE ALL &amp; REBOOT"
                                Height="36"
                                Margin="0,0,0,8"
                                Command="{Binding SaveAllSettingsCommand}" />
                        <Button Content="⏻ REBOOT"
                                Height="36"
                                Command="{Binding RebootCommand}" />
                        <TextBlock Text="Apply sends settings to device memory without saving. Save All persists to FRAM and reboots the device."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
    </DataTemplate>

    <!-- SOFTWARE SETTING tab body (hosted with DataContext = MLAstroController).
         Broker integration with the Three Point Polar Alignment plugin: handshake on/off, correction strategy
         and session state. -->
    <DataTemplate x:Key="MlaRpaSoftwareBody">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- The status sits OUTSIDE the expander so it stays visible even when the expander is collapsed. -->
                <Border Margin="0,0,0,10"
                        Padding="8,6"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding TppaBrokerStatusText}" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding BridgeStatusText}" />
                    </StackPanel>
                </Border>

                <Expander Header="External correction (three point polar alignment)"
                          Margin="0,0,0,15"
                          IsExpanded="True">
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding TppaBrokerEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      ToolTip="When on, the plugin announces its capabilities, receives the error from TPPA and drives the motors. TPPA must have external correction enabled in its own Settings tab." />
                            <TextBlock Text="Assign to Three Point Polar Alignment plugin"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                        </StackPanel>
                         
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Correction axis mode" />
                            <ComboBox Grid.Row="6"
                                      Grid.Column="1"
                                      MinWidth="160"
                                      Margin="5,0,0,0"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="{Binding CorrectionAxisModeIndex}"
                                      ToolTip="Both sends a single ALIGN command for both axes. Larger error axis only corrects the axis with the bigger remaining error.">
                                <ComboBoxItem>Both axes</ComboBoxItem>
                                <ComboBoxItem>Larger error axis</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="7" Margin="0,5,0,0" VerticalAlignment="Center" Text="Correction safety factor" />
                            <TextBox Grid.Row="7"
                                     Grid.Column="1"
                                     MinWidth="80"
                                     Margin="5,5,0,0"
                                     HorizontalAlignment="Left"
                                     Text="{Binding CorrectionSafetyFactor, StringFormat={}{0:0.##}}"
                                     ToolTip="Multiplied by the measured error before the move is sent (0.75 = correct 75 % of it). The altitude axis uses the full error instead when overshoot runs for that direction." />

                            <TextBlock Grid.Row="8" Margin="0,5,0,0" VerticalAlignment="Center" Text="Maximum step per correction (arcmin)" />
                            <TextBox Grid.Row="8"
                                     Grid.Column="1"
                                     MinWidth="80"
                                     Margin="5,5,0,0"
                                     HorizontalAlignment="Left"
                                     Text="{Binding CorrectionMaxStepArcMin, StringFormat={}{0:0.##}}"
                                     ToolTip="Upper limit for a single correction step - keeps a large error from producing a dangerous slew." />

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding CorrectionOvershootEnabled}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="Move past the target by the overshoot amount. The altitude axis uses the full error instead of the safety factor and the next measurement corrects whatever is left." />
                                    <TextBlock Text="Enable software overshoot"
                                               VerticalAlignment="Center"
                                               FontSize="14" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="24,5,0,0" Visibility="{Binding CorrectionOvershootEnabled, Converter={StaticResource MlaRpaBoolToVis}}">
                                <CheckBox IsChecked="{Binding CorrectionOvershootUpEnabled}"
                                          IsEnabled="{Binding CorrectionOvershootEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          ToolTip="Overshoot when the altitude axis has to move up. Off = the up step stops exactly on the target." />
                                <TextBlock Text="Enable overshoot when moving up"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Orientation="Horizontal" Visibility="{Binding CorrectionOvershootEnabled, Converter={StaticResource MlaRpaBoolToVis}}">
                                <TextBox MinWidth="80"
                                         IsEnabled="{Binding CorrectionOvershootEnabled}"
                                         Text="{Binding CorrectionOvershootUpArcMin, StringFormat={}{0:0.##}}"
                                         ToolTip="Overshoot when moving up (arcmin)." />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="Gray"
                                           FontSize="11"
                                           Text="arcmin" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="24,6,0,0" Visibility="{Binding CorrectionOvershootEnabled, Converter={StaticResource MlaRpaBoolToVis}}">
                                <CheckBox IsChecked="{Binding CorrectionOvershootDownEnabled}"
                                          IsEnabled="{Binding CorrectionOvershootEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          ToolTip="Overshoot when the altitude axis has to move down. Off = the down step stops exactly on the target." />
                                <TextBlock Text="Enable overshoot when moving down"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,6,0,0" Orientation="Horizontal" Visibility="{Binding CorrectionOvershootEnabled, Converter={StaticResource MlaRpaBoolToVis}}">
                                <TextBox MinWidth="80"
                                         IsEnabled="{Binding CorrectionOvershootEnabled}"
                                         Text="{Binding CorrectionOvershootDownArcMin, StringFormat={}{0:0.##}}"
                                         ToolTip="Overshoot when moving down (arcmin)." />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="Gray"
                                           FontSize="11"
                                           Text="arcmin" />
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Grid.ColumnSpan="2"
                                       Margin="0,5,0,0"
                                       Foreground="#C0392B"
                                       TextWrapping="Wrap"
                                       Text="{Binding OvershootWarningText}"
                                       Visibility="{Binding OvershootWarningVisibility}" />

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding SoftwareReverseAzimuth}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="Flips the azimuth (Left/Right) direction of the ALIGN commands this plugin sends during an external correction session." />
                                    <TextBlock Text="Reverse Azimuth direction (software)"
                                               VerticalAlignment="Center"
                                               FontSize="14" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox IsChecked="{Binding SoftwareReverseAltitude}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="Flips the altitude (Up/Down) direction of the ALIGN commands this plugin sends during an external correction session." />
                                    <TextBlock Text="Reverse Altitude direction (software)"
                                               VerticalAlignment="Center"
                                               FontSize="14" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Broker log" Margin="0,0,0,15" IsExpanded="True">
                  <StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="Gray"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="RPA &#8594; TPPA (blue) = sent to TPPA &#183; TPPA &#8594; RPA (green) = received from TPPA &#183; notice (yellow) = local status of this plugin." />
                    <!-- Transparent background so it follows the NINA theme (no white tint like the default ListBox). -->
                    <ListBox MinHeight="120"
                             MaxHeight="260"
                             Margin="0,8,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding BrokerLog}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFE082" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Direction}" Value="Tx">
                                                    <Setter Property="Foreground" Value="#4FC3F7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Direction}" Value="Rx">
                                                    <Setter Property="Foreground" Value="#81C784" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
