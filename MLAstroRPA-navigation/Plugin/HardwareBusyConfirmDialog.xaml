<Window x:Class="MLAstroRPA.Plugin.HardwareBusyConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warning: controller system is not ready"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnDragWindow">
    <Border BorderBrush="{Binding Foreground, ElementName=TitleText}" BorderThickness="3" Padding="18">
        <StackPanel MaxWidth="540">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Path Fill="#FFB000" Data="M 20,2 L 38,36 L 2,36 Z" />
                    <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#202020"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" Text="Warning: controller system is not ready"
                               FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="HeadlineText" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.85"
                               Text="The MLAstro axes are still turning. Stop the travel, so the three reference frames are captured with the axes standing still?" />
                </StackPanel>
            </Grid>

            <Border Margin="0,14,0,0" Padding="12" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LinkText" Margin="0,2,0,0" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock x:Name="AzText" Margin="0,10,0,0" />
                    <TextBlock x:Name="AltText" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="CountdownText" Margin="0,12,0,0" Opacity="0.75" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Stop the axes and continue" MinHeight="36" MinWidth="150" Padding="16,0" Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        Click="OnStopClick"
                        ToolTip="Stop the running travel and hand the axes over to the alignment run." />
                <Button Content="Skip" MinHeight="36" MinWidth="90" Padding="16,0"
                        VerticalContentAlignment="Center"
                        Click="OnSkipClick"
                        ToolTip="Skip the stop: the axes stay exactly as they are and the alignment run reports that the controller was not ready." />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
