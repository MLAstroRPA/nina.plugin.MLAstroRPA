<UserControl x:Class="MLAstroRPA.Dockables.PolarAlignmentDockable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MLAstroRPA.Converters"
             PreviewMouseMove="OnDockPreviewMouseMove">

    <UserControl.Resources>
        <converters:SpeedLevelToBoolConverter x:Key="SpeedLevelToBoolConverter"/>

        <!-- Speed Button Style - CIRCULAR button (square 40x40 + CornerRadius 20 = circle) -->
        <Style x:Key="SpeedButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3498DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Selected state styling via DataTrigger -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SpeedLevelToBoolConverter}">
                            <Binding Path="CurrentSpeed"/>
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Movement Button Style - ROUNDED TRIANGLE shape (direction is shown by the shape itself).
             Tag="Up|Down|Left|Right" on the Button picks the triangle geometry + label position. -->
        <Style x:Key="MovementButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="106"/>
            <Setter Property="Height" Value="106"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="shapeRoot">
                            <!-- Rounded triangle = triangle geometry filled AND stroked with
                                 StrokeLineJoin="Round" (the round join rounds the 3 corners).
                                 Single flat shape: no outline / shadow layer.
                                 All 4 directions use the SAME triangle (base 74 / axis 65) rotated 90°,
                                 so the cross stays even. Bigger StrokeThickness = bigger corner radius. -->
                            <!-- The Path sits on a Canvas ON PURPOSE: a Shape draws its geometry at the
                                 TOP-LEFT of its own layout box, and for a stroked path WPF sizes that box
                                 as geometry + StrokeThickness/2 — which shoved the triangle up-left and
                                 clipped it. On a Canvas the position is exactly Canvas.Left/Top, so the
                                 triangle's geometry box is simply centred in the button (default = Up/Down;
                                 Left/Right override Canvas.Left/Top in their Tag triggers). -->
                            <Canvas>
                                <Path x:Name="shape"
                                      Stretch="None"
                                      Fill="{TemplateBinding Background}"
                                      Stroke="{TemplateBinding Background}"
                                      StrokeThickness="26"
                                      StrokeLineJoin="Round"
                                      Data="M 37,0 L 74,65 L 0,65 Z"
                                      Canvas.Left="16"
                                      Canvas.Top="20.5"/>
                            </Canvas>
                            <!-- Label: TextBlock stretched to the FULL button width with
                                 TextAlignment="Center" (+ VerticalAlignment="Center"), so the word sits
                                 dead-centre of the button whatever the font metrics are.
                                 Style="{x:Null}" opts out of NINA's implicit TextBlock style, which could
                                 otherwise inject a margin/padding and push the text sideways. -->
                            <TextBlock x:Name="label"
                                       Text="{TemplateBinding Content}"
                                       Style="{x:Null}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Direction + label centring on the TRIANGLE CENTROID, not on the
                                 button centre: the centroid sits height/3 above the base, i.e. 65/6 = 10.8 px
                                 from the button centre toward the base. RenderTransform is used because it
                                 shifts the already-centred text without touching layout. -->
                            <Trigger Property="Tag" Value="Up">
                                <Setter TargetName="shape" Property="Data" Value="M 37,0 L 74,65 L 0,65 Z"/>
                                <Setter TargetName="label" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="10.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="Down">
                                <Setter TargetName="shape" Property="Data" Value="M 0,0 L 74,0 L 37,65 Z"/>
                                <Setter TargetName="label" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-10.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="Left">
                                <Setter TargetName="shape" Property="Data" Value="M 65,0 L 65,74 L 0,37 Z"/>
                                <!-- geometry box is 65x74 here => centre it: (106-65)/2, (106-74)/2 -->
                                <Setter TargetName="shape" Property="Canvas.Left" Value="20.5"/>
                                <Setter TargetName="shape" Property="Canvas.Top" Value="16"/>
                                <Setter TargetName="label" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="10.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="Right">
                                <Setter TargetName="shape" Property="Data" Value="M 0,0 L 0,74 L 65,37 Z"/>
                                <Setter TargetName="shape" Property="Canvas.Left" Value="20.5"/>
                                <Setter TargetName="shape" Property="Canvas.Top" Value="16"/>
                                <Setter TargetName="label" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="-10.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shape" Property="Fill" Value="#4A6278"/>
                                <Setter TargetName="shape" Property="Stroke" Value="#4A6278"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="shape" Property="Fill" Value="#2ECC71"/>
                                <Setter TargetName="shape" Property="Stroke" Value="#2ECC71"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="shapeRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Button Style with Press Effect -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="OrangeRed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E74C3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#922B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DirectionToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#4A4F55"/>
            <Setter Property="BorderBrush" Value="#4A4F55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"/>
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Fill="#111111"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3498DB"/>
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accent) Button Style - solid blue like the Align toggle ON state -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2980B9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2471A3"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2471A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- CONTENT - Scrollable -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Loaded="OnDockScrollViewerLoaded"
                      PreviewMouseWheel="OnDockScrollViewerPreviewMouseWheel">
            <StackPanel Margin="10">

            <!-- Disconnected notice (shown only when there is no serial connection) -->
            <TextBlock Text="⚠️ Not connected&#10;&#10;Open the plugin CONNECTION tab and connect to the MLAstro RPA hardware (Serial or Wireless) to start controlling."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#F39C12"
                       Margin="0,20,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ControlsVisibility}" Value="Collapsed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Manual Movement Control -->
            <Expander Header="🕹️ Manual Movement" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding ControlsVisibility}">
                <StackPanel Margin="10">
                    <!-- Speed Level -->
                    <TextBlock Text="Speed Level:" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <WrapPanel Margin="0,0,0,15" HorizontalAlignment="Center">
                        <Button Content="1" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="1" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="2" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="2" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="3" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="3" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="4" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="4" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="5" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="5" IsEnabled="{Binding CanManualControl}"/>
                    </WrapPanel>

                    <!-- Control Mode Toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <TextBlock Text="Jog (Hold)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox IsChecked="{Binding IsRelativeMode, Mode=TwoWay}" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,10,0"
                                  IsEnabled="{Binding CanManualControl}"/>
                        <TextBlock Text="Relative (Step)" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Relative Steps (visible only in Relative mode) — NO frame, NO Deg/Min/Sec labels -->
                    <WrapPanel Margin="0,0,0,15"
                               Visibility="{Binding RelativeOptionsVisibility}"
                               HorizontalAlignment="Center">
                            <!-- Degrees -->
                            <StackPanel Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" 
                                            PreviewMouseDown="OnRelativeDegreesDecDown" 
                                            PreviewMouseUp="OnRelativeDegreesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                    <TextBox Text="{Binding RelativeDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="deg"
                                             Width="44"
                                             MaxLength="2"
                                             TextAlignment="Center"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             FontWeight="Bold"
                                             Margin="5,0"
                                             IsEnabled="{Binding CanManualControl}"
                                             PreviewTextInput="OnRelativeDigitsOnly"
                                             PreviewKeyDown="OnRelativeKeyDown"
                                             GotKeyboardFocus="OnRelativeFieldGotFocus"/>
                                    <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="30" 
                                            PreviewMouseDown="OnRelativeDegreesIncDown" 
                                            PreviewMouseUp="OnRelativeDegreesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Minutes -->
                            <StackPanel Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" 
                                            PreviewMouseDown="OnRelativeMinutesDecDown" 
                                            PreviewMouseUp="OnRelativeMinutesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                    <TextBox Text="{Binding RelativeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="min"
                                             Width="44"
                                             MaxLength="2"
                                             TextAlignment="Center"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             FontWeight="Bold"
                                             Margin="5,0"
                                             IsEnabled="{Binding CanManualControl}"
                                             PreviewTextInput="OnRelativeDigitsOnly"
                                             PreviewKeyDown="OnRelativeKeyDown"
                                             GotKeyboardFocus="OnRelativeFieldGotFocus"/>
                                    <TextBlock Text="'" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="30" 
                                            PreviewMouseDown="OnRelativeMinutesIncDown" 
                                            PreviewMouseUp="OnRelativeMinutesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Seconds -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" 
                                            PreviewMouseDown="OnRelativeSecondsDecDown" 
                                            PreviewMouseUp="OnRelativeSecondsButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                    <TextBox Text="{Binding RelativeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="sec"
                                             Width="44"
                                             MaxLength="2"
                                             TextAlignment="Center"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             FontWeight="Bold"
                                             Margin="5,0"
                                             IsEnabled="{Binding CanManualControl}"
                                             PreviewTextInput="OnRelativeDigitsOnly"
                                             PreviewKeyDown="OnRelativeKeyDown"
                                             GotKeyboardFocus="OnRelativeFieldGotFocus"/>
                                    <TextBlock Text='"' VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="30" 
                                            PreviewMouseDown="OnRelativeSecondsIncDown" 
                                            PreviewMouseUp="OnRelativeSecondsButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                </StackPanel>
                            </StackPanel>
                    </WrapPanel>

                    <!-- Directional Pad -->
                    <Grid Width="320" Height="320" Margin="0,0,0,15" HorizontalAlignment="Center">
                        <!-- Up Button -->
                        <Button Content="Alt"
                                Tag="Up"
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                PreviewMouseDown="OnMoveUpDown"
                                PreviewMouseUp="OnMoveUpUp"
                                MouseLeave="OnMoveUpUp"
                                IsEnabled="{Binding CanJogAltUp}"/>

                        <!-- Left Button -->
                        <Button Content="Az"
                                Tag="Left"
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                PreviewMouseDown="OnMoveLeftDown"
                                PreviewMouseUp="OnMoveLeftUp"
                                MouseLeave="OnMoveLeftUp"
                                IsEnabled="{Binding CanJogAzLeft}"/>

                        <!-- Stop Button: text label ONLY (no glyph/icon). A plain string content is
                             rendered by the template's centred ContentPresenter, so the word STOP sits
                             dead-centre of the button (mid-centre), both horizontally and vertically. -->
                        <Button Content="STOP"
                                Style="{StaticResource StopButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding StopCommand}"/>

                        <!-- Right Button -->
                        <Button Content="Az"
                                Tag="Right"
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                PreviewMouseDown="OnMoveRightDown"
                                PreviewMouseUp="OnMoveRightUp"
                                MouseLeave="OnMoveRightUp"
                                IsEnabled="{Binding CanJogAzRight}"/>

                        <!-- Down Button -->
                        <Button Content="Alt"
                                Tag="Down"
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                PreviewMouseDown="OnMoveDownDown"
                                PreviewMouseUp="OnMoveDownUp"
                                MouseLeave="OnMoveDownUp"
                                IsEnabled="{Binding CanJogAltDown}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Position Display -->
            <Expander Header="📐 Position" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding ControlsVisibility}">
                <StackPanel Margin="10">
                    <!-- Azimuth Position -->
                    <TextBlock Text="Azimuth (from home):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding AzPosition}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

                    <!-- Altitude Position -->
                    <TextBlock Text="Altitude (from home):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBlock Text="{Binding AltPosition}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

                    <!-- Homed Status -->
                    <TextBlock Margin="0,15,0,10">
                        <Run Text="🏠 Homed:"/>
                        <Run Text="{Binding HomedStatus}" FontWeight="Bold"/>
                    </TextBlock>

                    <!-- Home Button -->
                    <WrapPanel Margin="0,0,0,0">
                        <Button x:Name="ReturnHomeButton"
                                Content="↻ RETURN TO HOME" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="40"
                                Margin="0,0,5,5"
                                Command="{Binding ReturnHomeCommand}"
                                IsEnabled="{Binding CanAutomaticControl}"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Polar Alignment -->
            <Expander Header="🎯 Polar Alignment" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding ControlsVisibility}">
                <StackPanel Margin="10">
                    <!-- Moved Position Display -->
                    <Border Background="#2C3E50" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Az Moved -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Az Moved" 
                                           FontSize="11" 
                                           Foreground="#BDC3C7" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AzMovedPosition}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Alt Moved -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Alt Moved" 
                                           FontSize="11" 
                                           Foreground="#BDC3C7" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AltMovedPosition}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Az Error Input -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Az Error:" FontWeight="SemiBold" Margin="0,0,15,5"/>
                        <!-- The DMS boxes also talk to the hardware (Enter sends AzED/AzEM/AzES + AzDi), so they are
                             locked with the same CanModify gate as the direction toggles / Align buttons: TPPA keeps
                             writing these values itself while it owns the hardware. Telemetry still updates them. -->
                        <WrapPanel Grid.Column="1" Grid.Row="0" Margin="0,0,20,5">
                            <TextBox Text="{Binding AzErrorDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="az" Width="60" Margin="0,0,5,0" IsEnabled="{Binding CanModify}" GotKeyboardFocus="OnAlignmentInputGotFocus" KeyDown="OnAlignmentInputKeyDown"/>
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AzErrorMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="az" Width="60" Margin="0,0,5,0" IsEnabled="{Binding CanModify}" GotKeyboardFocus="OnAlignmentInputGotFocus" KeyDown="OnAlignmentInputKeyDown"/>
                            <TextBlock Text="'" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AzErrorSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="az" Width="60" Margin="0,0,5,0" IsEnabled="{Binding CanModify}" GotKeyboardFocus="OnAlignmentInputGotFocus" KeyDown="OnAlignmentInputKeyDown"/>
                            <TextBlock Text='"' VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Direction toggle = a switch that sends AzDi/AlDi to the firmware the moment it is
                                 flipped, so it must be locked exactly like the Align buttons while an external
                                 controller (TPPA) owns the hardware: CanModify = not automated AND not
                                 external-locked. Telemetry keeps syncing IsChecked either way. -->
                            <CheckBox IsChecked="{Binding AzErrorRight, Mode=TwoWay}"
                                      Style="{StaticResource DirectionToggleStyle}"
                                      IsEnabled="{Binding CanModify}"
                                      VerticalAlignment="Center"
                                      GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Grid.RowSpan="2" Content="Align Az" Width="100" VerticalAlignment="Center" Command="{Binding AlignAzCommand}" IsEnabled="{Binding CanAlign}"/>
                    </Grid>

                    <Border Height="1" Background="#3A4654" Opacity="0.55" Margin="0,0,0,15"/>

                    <!-- Alt Error Input -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Alt Error:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <!-- Same lock as the Az row: disabled while TPPA (external control) owns the hardware. -->
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBox Text="{Binding AltErrorDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="alt" Width="60" Margin="0,0,5,0" IsEnabled="{Binding CanModify}" GotKeyboardFocus="OnAlignmentInputGotFocus" KeyDown="OnAlignmentInputKeyDown"/>
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AltErrorMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="alt" Width="60" Margin="0,0,5,0" IsEnabled="{Binding CanModify}" GotKeyboardFocus="OnAlignmentInputGotFocus" KeyDown="OnAlignmentInputKeyDown"/>
                            <TextBlock Text="'" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AltErrorSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="alt" Width="60" Margin="0,0,5,0" IsEnabled="{Binding CanModify}" GotKeyboardFocus="OnAlignmentInputGotFocus" KeyDown="OnAlignmentInputKeyDown"/>
                            <TextBlock Text='"' VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Up" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <!-- Same lock as the Az toggle: this switch also pushes AlDi down to the firmware
                                 immediately, so it is disabled while TPPA (external control) owns the hardware. -->
                            <CheckBox IsChecked="{Binding AltErrorUp, Mode=TwoWay}"
                                      Style="{StaticResource DirectionToggleStyle}"
                                      IsEnabled="{Binding CanModify}"
                                      HorizontalAlignment="Center"
                                      GotKeyboardFocus="OnAlignmentInputGotFocus">
                                <CheckBox.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                            <TextBlock Text="Down" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Align Alt" Width="100" VerticalAlignment="Center" Command="{Binding AlignAltCommand}" IsEnabled="{Binding CanAlign}"/>
                    </Grid>

                    <!-- Align All Button -->
                    <Button Content="✓ ALIGN ALL" 
                            Width="{Binding ActualWidth, ElementName=ReturnHomeButton}"
                            HorizontalAlignment="Left"
                            Height="40"
                            Background="Green"
                            Foreground="White"
                            IsEnabled="{Binding CanAlign}"
                            FontWeight="Bold"
                            FontSize="16"
                            Command="{Binding AlignAllCommand}"/>
                </StackPanel>
            </Expander>

            <!-- Alarm History (industrial HMI style): only ERROR/WARNING codes are shown; each row
                 carries the activation time and, once cleared, the end time on the SAME row.
                 Newest alarm on TOP, older ones below (same order as the System log panels). -->
            <Expander Header="⚠️ Alarm History" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding AlarmHistoryVisibility}">
                <StackPanel Margin="6">
                    <Button Content="🗑 CLEAR"
                            HorizontalAlignment="Right"
                            Padding="12,4"
                            Margin="0,0,0,6"
                            Background="#3A4654"
                            Foreground="White"
                            BorderBrush="#55636F"
                            ToolTip="Clear the whole alarm history"
                            Command="{Binding ClearAlarmHistoryCommand}"/>
                    <DataGrid ItemsSource="{Binding AlarmHistory}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Background="#1E272E"
                              Foreground="White"
                              BorderBrush="#3A4654"
                              BorderThickness="1"
                              FontSize="12"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Severity" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeverityText}"
                                                   Foreground="{Binding SeverityBrush}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Activated" Binding="{Binding ActivatedText}" Width="80"/>
                            <DataGridTextColumn Header="Cleared" Binding="{Binding ClearedText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
